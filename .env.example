# Copy to .env (never commit .env). Used only by the server route src/routes/api/chat/.
# Get a key at https://aistudio.google.com/apikey — without it the chat answers in offline (rule-based) mode.
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_BACKUP_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
