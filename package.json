{
	"name": "phoun-phan-portfolio",
	"private": true,
	"version": "2.0.0",
	"type": "module",
	"description": "Portfolio and digital CV of Phoun Phan — AI/ML Engineer (Computer Vision & OCR), Phnom Penh.",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"images": "node scripts/prepare-images.mjs",
		"cv": "node scripts/generate-cv.mjs",
		"links": "node scripts/check-links.mjs",
		"test:e2e": "playwright test",
		"verify": "npm run check && npm run build && npm run links && npm run test:e2e"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/noto-sans-khmer": "^5.3.0",
		"@lucide/svelte": "^1.76.0",
		"simple-icons": "^16.38.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^22",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"sharp": "^0.35.5",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	}
}
